{
  "expo": {
    "name": "HerHealth",
    "slug": "herhealth",
    "scheme": "herhealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "HerHealth uses the microphone so you can log health entries by voice.",
        "NSMotionUsageDescription": "HerHealth reads your step count.",
        "NSFaceIDUsageDescription": "Unlock HerHealth with Face ID."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "ACTIVITY_RECOGNITION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.miraa123.herhealth"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow HerHealth to securely unlock with biometric authentication."
        }
      ]
    ],
    "backgroundColor": "#D9DAE4",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "778bc96c-3737-4d30-aca9-ca98cf7fc128"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/778bc96c-3737-4d30-aca9-ca98cf7fc128"
    }
  }
}
